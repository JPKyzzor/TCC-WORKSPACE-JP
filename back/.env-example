# Spring profile
# Use 'dev' para rodar local no IntelliJ
# Use 'prod' no Render
SPRING_PROFILES_ACTIVE=dev

# Database (Render Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RENDER_HOST:5432/YOUR_DB_NAME
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# JWT
APP_JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_EXPIRATION_MS=28800000

# Gemini (required)
LANGCHAIN4J_GOOGLE_AI_GEMINI_CHAT_MODEL_API_KEY=YOUR_GEMINI_API_KEY
LANGCHAIN4J_GOOGLE_AI_GEMINI_CHAT_MODEL_MODEL_NAME=gemini-2.5-flash

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Exemplo para produção (Render):
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=https://tcc-workspace.vercel.app
